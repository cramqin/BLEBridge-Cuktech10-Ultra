<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions required for older Android devices -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    
    <!-- Permissions required for Android 12+ (API 31+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    
    <!-- Location is necessary for general BLE discovery on various Android versions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Internet & Net interfaces for hosting the socket bridge gateway -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground services and status notifications -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Storage permissions for CSV export to Downloads/cuktech10/history -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <queries>
        <package android:name="com.xiaomi.smarthome" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        tools:targetApi="34">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".BleBridgeService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".BleCommandReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.cramqin.blecuktech10.START_SERVER" />
                <action android:name="com.cramqin.blecuktech10.STOP_SERVER" />
                <action android:name="com.cramqin.blecuktech10.CONNECT_CHARGER" />
                <action android:name="com.cramqin.blecuktech10.DISCONNECT_CHARGER" />
                <action android:name="com.cramqin.blecuktech10.SCAN_CHARGER" />
                <action android:name="com.cramqin.blecuktech10.SET_PORT_STATE" />
                <action android:name="com.cramqin.blecuktech10.SET_SCENE_MODE" />
                <action android:name="com.cramqin.blecuktech10.SET_SCREEN_TIMEOUT" />
                <action android:name="com.cramqin.blecuktech10.SET_CHARGE_LIMIT" />
                <action android:name="com.cramqin.blecuktech10.SET_AUTO_CONNECT" />
                <action android:name="com.cramqin.blecuktech10.QUERY_STATUS" />
                <action android:name="com.example.action.START_SERVER" />
                <action android:name="com.example.action.STOP_SERVER" />
            </intent-filter>
        </receiver>

        <!-- Tasker / Locale Action Plugin Activity -->
        <activity
            android:name=".tasker.TaskerEditActivity"
            android:icon="@mipmap/ic_launcher"
            android:label="CUKTECH 10 Ultra"
            android:exported="true">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>

        <!-- Tasker / Locale Action Plugin Receiver -->
        <receiver
            android:name=".tasker.TaskerFireReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
            </intent-filter>
        </receiver>

        <!-- HyperOS Soft Glass 4x2 Control Center Widget -->
        <receiver
            android:name=".widget.CuktechWidget4x2Provider"
            android:label="CUKTECH 10 · 4x2 Soft Glass"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.cramqin.blecuktech10.WIDGET_TOGGLE_PORT_1" />
                <action android:name="com.cramqin.blecuktech10.WIDGET_TOGGLE_PORT_2" />
                <action android:name="com.cramqin.blecuktech10.WIDGET_TOGGLE_PORT_3" />
                <action android:name="com.cramqin.blecuktech10.WIDGET_TOGGLE_PORT_4" />
                <action android:name="com.cramqin.blecuktech10.WIDGET_CYCLE_SCENE" />
                <action android:name="com.cramqin.blecuktech10.WIDGET_CONNECT_OR_OPEN" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cuktech_4x2_info" />
        </receiver>

        <!-- HyperOS Soft Glass 2x2 Compact Tile Widget -->
        <receiver
            android:name=".widget.CuktechWidget2x2Provider"
            android:label="CUKTECH 10 · 2x2 Soft Glass"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cuktech_2x2_info" />
        </receiver>

        <!-- Solid Dark 4x2 Control Center Widget -->
        <receiver
            android:name=".widget.CuktechWidget4x2SolidProvider"
            android:label="CUKTECH 10 · 4x2 Solid Dark"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cuktech_4x2_solid_info" />
        </receiver>

        <!-- Solid Dark 2x2 Compact Tile Widget -->
        <receiver
            android:name=".widget.CuktechWidget2x2SolidProvider"
            android:label="CUKTECH 10 · 2x2 Solid Dark"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cuktech_2x2_solid_info" />
        </receiver>

    </application>

</manifest>
