<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- HyperOS 4 / iOS 27 Frosted Ice Glass: milky white/ice-blue frosted diffusion -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="135"
                android:startColor="#78F8FAFC"
                android:centerColor="#54CBD5E1"
                android:endColor="#68E2E8F0"
                android:type="linear" />
            <stroke
                android:width="1.4dp"
                android:color="#99FFFFFF" />
        </shape>
    </item>
    <!-- Inner milky frost glow (matches HyperOS 4 Frosted Glass preview) -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <gradient
                android:angle="270"
                android:startColor="#45FFFFFF"
                android:centerColor="#18FFFFFF"
                android:endColor="#30FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
