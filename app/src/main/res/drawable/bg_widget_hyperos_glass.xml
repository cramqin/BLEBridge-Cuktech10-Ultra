<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer soft glass base with frosted dark tint -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="135"
                android:startColor="#E61A202C"
                android:centerColor="#DE121620"
                android:endColor="#EA0C0F17"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
        </shape>
    </item>
    <!-- Top subtle specular glass highlight -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <gradient
                android:angle="270"
                android:startColor="#14FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
